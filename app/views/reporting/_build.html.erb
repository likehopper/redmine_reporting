<section class="reporting-section" role="tabpanel" id="panel-build" aria-labelledby="tab-build" data-reporting-panel="build" <%= "hidden" unless @active_tab == "build" %>>
  <h3 class="reporting-section-hdr"><%= l(:"reporting.tabs.build") %></h3>
  <div class="reporting-section-body">
    <p class="reporting-desc"><%= l(:"reporting.build.scope") %></p>
    <% if @report_data[:build][:versions].empty? %>
      <p class="reporting-empty"><%= l(:"reporting.build.empty") %></p>
    <% else %>
      <div class="reporting-chart-grid">
        <% charts = %w[progress deadlines] %>
        <% charts += %w[charges] if @capabilities.time? %>
        <% charts.each do |chart| %>
          <article>
            <h4><%= l(:"reporting.build.#{chart}") %></h4>
            <p class="reporting-desc"><%= l(:"reporting.build.#{chart}_desc") %></p>
            <div class="reporting-chart tall"><canvas id="build-<%= chart %>"></canvas></div>
          </article>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
