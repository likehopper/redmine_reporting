<h2><%= link_to l(:label_reporting), settings_project_path(@project, tab: "reporting") %> » <%= @policy.name %></h2>

<%= labelled_form_for :reporting_credit_policy, @policy, url: project_reporting_credit_policy_path(project_id: @project, id: @policy), html: {method: :patch} do |f| %>
  <%= render partial: "form", locals: {f: f} %>
  <%= submit_tag l(:button_save) %>
<% end %>
