api.reporting_setting do
  # No id when the project uses the defaults; inherited_from names the ancestor that owns the row.
  api.id @setting.id
  api.project(id: @project.id, name: @project.name)
  api.inherited_from(id: @setting.project_id, name: @setting.project.name) if @setting.inherited_by?(@project)
  api.hours_per_day @setting.hours_per_day.to_f
  api.array :section_ids do
    @setting.section_ids.each { |section_id| api.section_id section_id }
  end
  %w[run build].each do |role|
    api.array :"#{role}_trackers" do
      Tracker.where(id: @setting.public_send(:"#{role}_tracker_ids")).sorted.each do |tracker|
        api.tracker(id: tracker.id, name: tracker.name)
      end
    end
  end
end
