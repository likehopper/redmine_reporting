<% content_for :header_tags do %>
  <%= stylesheet_link_tag "reporting", plugin: "redmine_reporting" %>
<% end %>
<% page = RedmineReporting::ProjectSettings.new(@project) %>
<% setting, sla = page.setting, page.sla %>
<% pane = page.pane(params[:reporting_pane]) %>

<div id="reporting-settings">
  <% if page.inherited? %>
    <p class="warning"><%= l(:"reporting.settings.inherited", project: setting.project.name) %></p>
  <% end %>

  <div class="reporting-settings-layout">
    <nav class="reporting-settings-nav" aria-label="<%= l(:label_reporting) %>">
      <ul>
        <% page.panes.each do |item| %>
          <li><%= link_to l(:"reporting.settings.#{item}"), settings_project_path(@project, tab: "reporting", reporting_pane: item),
                    id: "reporting-pane-#{item}", class: (item == pane ? "selected" : nil), aria: {current: (item == pane ? "page" : nil)} %></li>
        <% end %>
      </ul>
    </nav>

    <div class="reporting-settings-pane" id="reporting-pane-content-<%= pane %>">
      <% if pane == "contracts" %>
        <%= render "reporting_settings/contracts", page: page %>
      <% elsif pane == "sla_statuses" %>
        <%= render "reporting_settings/sla_statuses", page: page %>
      <% else %>
        <%= form_tag project_reporting_settings_path(project_id: @project), method: :patch, class: "reporting-settings-form" do %>
          <%= hidden_field_tag "reporting_pane", pane, id: nil %>
          <%= render "reporting_settings/#{pane}", page: page, setting: setting, sla: sla %>
          <p><%= submit_tag l(:button_save) %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
