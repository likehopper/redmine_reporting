<% page = RedmineReporting::ProjectSettings.new(@project) %>
<% setting, sla = page.setting, page.sla %>

<%= form_tag project_reporting_settings_path(project_id: @project), method: :patch, id: "reporting-settings" do %>
  <% if page.inherited? %>
    <p class="warning"><%= l(:"reporting.settings.inherited", project: setting.project.name) %></p>
  <% end %>

  <fieldset class="box tabular">
    <legend><%= l(:"reporting.settings.sections") %></legend>
    <%= hidden_field_tag "reporting_setting[section_ids][]", "", id: nil %>
    <% page.sections.each do |section| %>
      <p>
        <label for="reporting_section_<%= section.id %>"><%= l(:"reporting.settings.section.#{section.id}") %></label>
        <%= check_box_tag "reporting_setting[section_ids][]", section.id, setting.section_enabled?(section.id),
              id: "reporting_section_#{section.id}", disabled: !section.selectable? %>
        <em class="info">
          <%= l(:"reporting.settings.section_desc.#{section.id}") %>
          <% if section.requires == :sla %>
            · <%= l(:"reporting.settings.sla.#{sla.state}") %>
          <% end %>
          <% if section.planned %>· <strong><%= l(:"reporting.settings.planned") %></strong><% end %>
        </em>
      </p>
    <% end %>
  </fieldset>

  <fieldset class="box tabular">
    <legend><%= l(:"reporting.settings.time_unit") %></legend>
    <p>
      <label for="reporting_setting_hours_per_day"><%= l(:field_hours_per_day) %></label>
      <%= number_field_tag "reporting_setting[hours_per_day]", setting.hours_per_day.to_f, min: 0.25, max: 24, step: 0.25,
            id: "reporting_setting_hours_per_day", size: 5 %>
      <em class="info"><%= l(:"reporting.settings.hours_per_day_desc") %></em>
    </p>
  </fieldset>

  <fieldset class="box">
    <legend><%= l(:"reporting.settings.trackers") %></legend>
    <p class="info"><%= l(:"reporting.settings.trackers_desc") %></p>
    <table class="list reporting-tracker-roles">
      <thead>
        <tr>
          <th><%= l(:field_tracker) %></th>
          <% %w[run build none].each do |role| %><th><%= l(:"reporting.settings.tracker_role.#{role}") %></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% page.trackers.each do |tracker| %>
          <tr>
            <td class="name"><%= tracker.name %></td>
            <% {"run" => "run", "build" => "build", "none" => ""}.each do |role, value| %>
              <td><%= radio_button_tag "reporting_setting[tracker_roles][#{tracker.id}]", value, setting.tracker_role(tracker) == value,
                        id: "reporting_tracker_#{tracker.id}_#{role}", aria: {label: "#{tracker.name} · #{l(:"reporting.settings.tracker_role.#{role}")}"} %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </fieldset>

  <% if sla.configured? %>
  <fieldset class="box">
    <legend><%= l(:"reporting.settings.sla_statuses") %></legend>
    <p class="info"><%= l(:"reporting.settings.sla_statuses_desc") %></p>
    <table class="list reporting-sla-statuses">
      <thead><tr><th><%= l(:"reporting.settings.sla_type") %></th><th><%= l(:"reporting.settings.sla_active_statuses") %></th></tr></thead>
      <tbody>
        <% sla.active_statuses_by_type.each do |type, statuses| %>
          <tr><td class="name"><%= type.name %></td><td><%= statuses.map(&:name).join(", ") %></td></tr>
        <% end %>
        <tr><td class="name"><strong><%= l(:"reporting.settings.sla_waiting_statuses") %></strong></td>
          <td><%= page.sla_waiting_statuses.map(&:name).join(", ").presence || "—" %></td></tr>
      </tbody>
    </table>
  </fieldset>
  <% end %>

  <p><%= submit_tag l(:button_save) %></p>
<% end %>

<fieldset class="box">
  <legend><%= l(:"reporting.settings.credits") %></legend>
  <p class="info"><%= l(:"reporting.settings.credits_desc", hours: reporting_hours(setting.hours_per_day)) %></p>
  <% policies = page.policies %>
  <% if policies.any? %>
    <table class="list reporting-credit-policies">
      <thead>
        <tr>
          <th><%= l(:field_tracker) %></th><th><%= l(:field_name) %></th><th><%= l(:field_initial_credit_days) %></th>
          <th><%= l(:"reporting.settings.anniversary") %></th><th><%= l(:"reporting.settings.validity") %></th>
          <th><%= l(:"reporting.settings.refills") %></th><th><%= l(:field_enabled) %></th><th></th>
        </tr>
      </thead>
      <tbody>
        <% policies.each do |policy| %>
          <tr class="<%= "disabled" unless policy.enabled %>">
            <td class="name"><%= policy.tracker.name %></td>
            <td><%= policy.name %></td>
            <td><%= reporting_days(policy.initial_credit_days) %></td>
            <td><%= reporting_day_of_year(policy.anniversary_month, policy.anniversary_day) %></td>
            <td><%= reporting_validity(policy.active_from, policy.active_until) %></td>
            <td><%= safe_join(policy.sorted_refills.map { |refill|
                      l(:"reporting.settings.refill", days: reporting_days(refill.credit_days), date: reporting_day_of_year(refill.month, refill.day)) }, tag.br) %></td>
            <td><%= checked_image policy.enabled %></td>
            <td class="buttons">
              <%= link_to reporting_icon("edit", l(:button_edit)), edit_project_reporting_credit_policy_path(project_id: @project, id: policy), class: "icon icon-edit" %>
              <%= link_to reporting_icon("del", l(:button_delete)), project_reporting_credit_policy_path(project_id: @project, id: policy), method: :delete,
                    data: {confirm: l(:text_are_you_sure)}, class: "icon icon-del" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% end %>
  <% if page.trackers_for_policy.any? %>
    <p><%= link_to reporting_icon("add", l(:"reporting.settings.new_policy")), new_project_reporting_credit_policy_path(project_id: @project), class: "icon icon-add" %></p>
  <% end %>
</fieldset>
