<% summary = @report_data[:summary] %>
<% active_issues = @dashboard.active_issue_parameters %>
<% description = @dashboard.description %>
<% filters = description.readable_filters %>
<% from, to = @dashboard.date_from, @dashboard.date_to %>
<div class="reporting-banner">
  <div class="reporting-scope">
    <p><strong><%= l(:"reporting.tabs.#{@active_tab}") %></strong> — <%= @dashboard.scope(@active_tab) %></p>
    <p class="reporting-scope-filters">
      <%= l(:"reporting.scope.projects", projects: description.readable_projects) %>
      · <%= l(:"reporting.scope.filters", filters: filters.any? ? filters.join(" ; ") : l(:"reporting.scope.no_filter")) %>
    </p>
  </div>
  <div class="reporting-kpis">
    <% if @capabilities.issues? %>
    <div class="reporting-kpi-group" aria-label="<%= l(:"reporting.summary.issues") %>">
      <%= link_to @dashboard.details_path(**active_issues), class: "reporting-stat", target: "_blank", rel: "noopener", title: l(:"reporting.summary.total_title", from: from, to: to) do %>
        <span class="value"><%= summary[:issues] %></span><span class="label"><%= l(:"reporting.summary.total") %></span>
      <% end %>
      <%= link_to @dashboard.details_path(**active_issues, open: "true"), class: "reporting-stat", target: "_blank", rel: "noopener", title: l(:"reporting.summary.open_title") do %>
        <span class="value reporting-red"><%= summary[:openIssues] %></span><span class="label"><%= l(:"reporting.summary.open") %></span>
      <% end %>
      <%= link_to @dashboard.details_path(records: "issues", created_to: @date_to, closed_from: @date_from, closed: "true"), class: "reporting-stat", target: "_blank", rel: "noopener", title: l(:"reporting.summary.closed_title") do %>
        <span class="value reporting-green"><%= summary[:closedIssues] %></span><span class="label"><%= l(:"reporting.summary.closed") %></span>
      <% end %>
      <div class="reporting-stat" title="<%= l(:"reporting.summary.closed_ratio_title") %>">
        <span class="value"><%= summary[:closedRatio] %>%</span><span class="label"><%= l(:"reporting.summary.closed_ratio") %></span>
        <span class="reporting-progress"><span style="width: <%= summary[:closedRatio] %>%"></span></span>
      </div>
    </div>
    <% end %>
    <% if @capabilities.time? %>
    <div class="reporting-kpi-group" aria-label="<%= l(:"reporting.summary.time") %>">
      <% if @capabilities.issues? %>
      <%# Estimated − done = left to do + gap on closed issues, over the same issues. %>
      <% period_times = @dashboard.details_path(**active_issues, times: "true") %>
      <%= link_to period_times, class: "reporting-stat", target: "_blank", rel: "noopener",
            title: l(:"reporting.summary.estimated_title", count: summary[:issues], unestimated: summary[:unestimatedIssues]) do %>
        <span class="value"><%= reporting_days(summary[:estimatedDays]) %></span><span class="label"><%= l(:"reporting.summary.estimated") %></span>
      <% end %>
      <%= link_to period_times, class: "reporting-stat", target: "_blank", rel: "noopener",
            title: l(:"reporting.summary.done_title", count: summary[:issues], hours: @dashboard.hours_per_day) do %>
        <span class="value"><%= reporting_days(summary[:doneDays]) %></span><span class="label"><%= l(:"reporting.summary.done") %></span>
      <% end %>
      <%= link_to @dashboard.details_path(**active_issues, open: "true", times: "true"), class: "reporting-stat", target: "_blank", rel: "noopener",
            title: l(:"reporting.summary.remaining_title", count: summary[:openIssues], estimated: format_hours(summary[:openEstimatedHours]),
                     done: format_hours(summary[:openDoneHours]), closed: summary[:closedIssues], hours: @dashboard.hours_per_day) do %>
        <span class="value<%= " reporting-red" if summary[:remainingDays].negative? %>"><%= reporting_days(summary[:remainingDays]) %></span>
        <span class="label"><%= l(:"reporting.summary.remaining") %></span>
        <span class="detail"><%= l(:"reporting.summary.closed_gap", gap: reporting_signed_days(summary[:closedGapDays])) %></span>
      <% end %>
      <div class="reporting-stat" title="<%= l(:"reporting.summary.progress_title") %>">
        <span class="value"><%= summary[:progress] %>%</span><span class="label"><%= l(:"reporting.summary.progress") %></span>
        <span class="reporting-progress"><span style="width: <%= [summary[:progress], 100].min %>%"></span></span>
      </div>
      <% else %>
      <%= link_to @dashboard.details_path(records: "time_entries"), class: "reporting-stat", target: "_blank", rel: "noopener", title: l(:"reporting.summary.spent_title", from: from, to: to, hours: @dashboard.hours_per_day) do %>
        <span class="value"><%= reporting_days(summary[:spentDays]) %></span><span class="label"><%= l(:"reporting.summary.spent") %></span>
      <% end %>
      <% end %>
    </div>
    <% end %>
  </div>
</div>
