<% {"workload" => %w[assignees remaining], "team_activity" => %w[contributors mix]}.each do |tab, charts| %>
  <% next unless @tabs.include?(tab) %>
  <section class="reporting-section" role="tabpanel" id="panel-<%= tab %>" aria-labelledby="tab-<%= tab %>" data-reporting-panel="<%= tab %>" <%= "hidden" unless @active_tab == tab %>>
    <h3 class="reporting-section-hdr"><%= l(:"reporting.tabs.#{tab}") %></h3>
    <div class="reporting-section-body">
      <p class="reporting-desc"><%= l(:"reporting.workload.#{tab}_scope", from: @dashboard.date_from, to: @dashboard.date_to) %></p>
      <div class="reporting-chart-grid">
        <% charts.each do |chart| %>
          <% rows = @report_data[:workload][chart.to_sym] %>
          <% next unless rows %>
          <article>
            <h4><%= l(:"reporting.workload.#{chart}") %></h4>
            <p class="reporting-desc"><%= l(:"reporting.workload.#{chart}_desc") %></p>
            <% if rows.empty? %>
              <p class="reporting-empty"><%= l(:"reporting.workload.empty") %></p>
            <% else %>
              <div class="reporting-chart tall"><canvas id="workload-<%= chart %>"></canvas></div>
            <% end %>
          </article>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
