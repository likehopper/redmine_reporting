<section class="reporting-section" role="tabpanel" id="panel-burnup" aria-labelledby="tab-burnup" data-reporting-panel="burnup" <%= "hidden" unless @active_tab == "burnup" %>>
  <h3 class="reporting-section-hdr"><%= l(:"reporting.tabs.burnup") %></h3>
  <div class="reporting-section-body">
    <p class="reporting-desc"><%= l(:"reporting.burnup.description") %></p>
    <p class="reporting-desc"><%= l(:"reporting.burnup.limitations") %></p>
    <% if @report_data[:burnup][:versions].empty? %>
      <p class="reporting-empty"><%= l(:"reporting.burnup.empty") %></p>
    <% end %>
    <div class="reporting-chart-grid">
      <% @report_data[:burnup][:versions].each_with_index do |version, index| %>
        <article>
          <h4><%= version[:name] || l(:"reporting.js.build_unversioned") %></h4>
          <div class="reporting-chart"><canvas id="burnup-<%= index %>"></canvas></div>
        </article>
      <% end %>
    </div>
  </div>
</section>
