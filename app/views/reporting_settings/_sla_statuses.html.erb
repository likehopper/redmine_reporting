<div class="box">
  <p class="info"><%= l(:"reporting.settings.sla_statuses_desc") %></p>
  <table class="list reporting-sla-statuses">
    <thead><tr><th><%= l(:"reporting.settings.sla_type") %></th><th><%= l(:"reporting.settings.sla_active_statuses") %></th></tr></thead>
    <tbody>
      <% page.sla.active_statuses_by_type.each do |type, statuses| %>
        <tr><td class="name"><%= type.name %></td><td><%= statuses.map(&:name).join(", ") %></td></tr>
      <% end %>
      <tr><td class="name"><strong><%= l(:"reporting.settings.sla_waiting_statuses") %></strong></td>
        <td><%= page.sla_waiting_statuses.map(&:name).join(", ").presence || "—" %></td></tr>
    </tbody>
  </table>
</div>
