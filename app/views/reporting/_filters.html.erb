<%= form_tag project_reporting_path(project_id: @project), method: :get, id: "query_form" do %>
  <%= hidden_field_tag :tab, @active_tab, id: "reporting-active-tab" %>
  <%= hidden_field_tag :set_filter, 1 %>
  <div id="query_form_with_buttons" class="hide-when-print">
    <div id="query_form_content">
      <fieldset id="filters" class="collapsible">
        <legend onclick="toggleFieldset(this);" class="icon icon-expanded"><%= sprite_icon("angle-down") if respond_to?(:sprite_icon) %><%= l(:label_filter_plural) %></legend>
        <div><%= render partial: "queries/filters", locals: { query: @query } %></div>
      </fieldset>
      <fieldset id="options" class="collapsible">
        <legend onclick="toggleFieldset(this);" class="icon icon-expanded"><%= sprite_icon("angle-down") if respond_to?(:sprite_icon) %><%= l(:label_options) %></legend>
        <div>
          <p>
            <%= label_tag :from, l(:label_date_from) %>
            <%= date_field_tag :from, @date_from, size: 10 %><%= calendar_for("from") %>
            <%= label_tag :to, l(:label_date_to) %>
            <%= date_field_tag :to, @date_to, size: 10 %><%= calendar_for("to") %>
          </p>
          <p>
            <%= label_tag :grouping, l(:label_reporting_grouping) %>
            <%= select_tag :grouping, options_for_select(RedmineReporting::PeriodGrid::GROUPINGS.map { |grouping| [l("label_reporting_grouping_#{grouping}"), grouping] }, @grouping) %>
          </p>
        </div>
      </fieldset>
    </div>
    <p class="buttons">
      <%= link_to_function (respond_to?(:sprite_icon) ? sprite_icon("checked", l(:button_apply)) : l(:button_apply)), "$('#query_form').submit()", class: "icon icon-checked" %>
      <%= link_to (respond_to?(:sprite_icon) ? sprite_icon("reload", l(:button_clear)) : l(:button_clear)), project_reporting_path(project_id: @project, tab: @active_tab), class: "icon icon-reload" %>
    </p>
  </div>
<% end %>
<%= error_messages_for @query %>
