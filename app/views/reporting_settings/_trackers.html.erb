<div class="box">
  <p class="info"><%= l(:"reporting.settings.trackers_desc") %></p>
  <table class="list reporting-tracker-roles">
    <thead>
      <tr>
        <th><%= l(:field_tracker) %></th>
        <% %w[run build none].each do |role| %><th><%= l(:"reporting.settings.tracker_role.#{role}") %></th><% end %>
      </tr>
    </thead>
    <tbody>
      <% page.trackers.each do |tracker| %>
        <tr>
          <td class="name"><%= tracker.name %></td>
          <% {"run" => "run", "build" => "build", "none" => ""}.each do |role, value| %>
            <td><%= radio_button_tag "reporting_setting[tracker_roles][#{tracker.id}]", value, setting.tracker_role(tracker) == value,
                      id: "reporting_tracker_#{tracker.id}_#{role}", aria: {label: "#{tracker.name} · #{l(:"reporting.settings.tracker_role.#{role}")}"} %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
