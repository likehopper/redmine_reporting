<div class="box tabular">
  <%= hidden_field_tag "reporting_setting[section_ids][]", "", id: nil %>
  <% page.sections.each do |section| %>
    <p>
      <label for="reporting_section_<%= section.id %>"><%= l(:"reporting.settings.section.#{section.id}") %></label>
      <%= check_box_tag "reporting_setting[section_ids][]", section.id, setting.section_enabled?(section.id),
            id: "reporting_section_#{section.id}", disabled: !section.selectable? %>
      <em class="info">
        <%= l(:"reporting.settings.section_desc.#{section.id}") %>
        <% if section.requires == :sla %>
          · <%= l(:"reporting.settings.sla.#{sla.state}") %>
        <% end %>
        <% if section.planned %>· <strong><%= l(:"reporting.settings.planned") %></strong><% end %>
      </em>
    </p>
  <% end %>
</div>
